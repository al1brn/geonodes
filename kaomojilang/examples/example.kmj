'''
example language that lets you draw svg curves and shapes using numbers.
'''

def sqaure_example(fill=red):  ## this draws an svg line stroke and fills it red
    1             2
    
    
    4             3

## the rules are by default, a sequence that starts with an odd number,
## draws a closed line shape, that can be filled

def ▢(fill=black, smooth=0.5):  ## this draws smooth closed square shape, smooth=1.0 is a circle
    0             1
    
    
    3             2

# example above, a smooth closed curve is drawn when the sequence starts with an even number

colors = {0:yellow, 10:white, 20:white, 30:black, 40:black}
sizes  = {30:large, 40:large}
def smooth_face_example(fill=colors, sizes=sizes):  ## draws a face in svg
         0
                   1
  7                  2
      10  11  20  21 
         30      40
      13  12  23  22
            50       3
             51
  6               
          60   61
                 4
            5

## example of eye pupil animation
anim_frames = [ smooth_face_example( {30:▢(smooth=random()), 40:▢(smooth=random())} ) for i in range(10)]

