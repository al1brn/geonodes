'''
ʕ•ᴥ•ʔ : a bear built from numbers. The ears, eyes, muzzle and nose are dots; the head is a smooth curve.
'''

## the mouth: an open curve (the trailing ~ ends it without closing it), stamped on the muzzle
def mouth(width=0.25, smooth=1.0):
    0           2~
          1

def bear(fill={0:brown, 11:brown, 15:brown, 20:black, 30:black, 40:tan, 50:black, 60:mouth()}, sizes={11:(7, 5), 15:(7, 5), 20:(2, 2), 30:(2, 2), 40:(12, 8), 50:(4, 3), 60:(7, 4)}):

     
                             0
                 11                   15
                   7                   1
     
     
                     20             30
               6                           2
                            50
                            40
                            60
                   5                   3
     
                             4

happy = bear({40: tan})
cuddly = [bear() , bear(scale={11: 1.3, 15: 1.3}), bear(scale={11: 0.8, 15: 0.8}), bear()]
